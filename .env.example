# Local-only settings. The backend reads backend/.env; Docker Compose can read
# this template with `docker compose --env-file .env.example up -d postgres`.
POSTGRES_USER=janaseva
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_DB=janaseva_ai
# Optional direct URL for Prisma migrations. Production migrations must use
# DATABASE_URL_UNPOOLED; leave unset for local PostgreSQL.
DATABASE_URL_UNPOOLED=
DATABASE_URL=postgresql://janaseva:replace-with-a-local-secret@localhost:5432/janaseva_ai?schema=public

# Backend HTTP port (frontend runs on 3001)
PORT=3002
FRONTEND_ORIGIN=http://localhost:3001

# Set the same random token in backend/.env and ai-service/.env.
AI_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# Use a random secret of at least 32 bytes; never expose it to the frontend.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=janaseva-ai-auth
# Production must set this to false. Production always rejects demo headers.
DOCUMENT_VERIFICATION_DEMO_AUTH_ENABLED=true

# Private local document storage; do not serve this directory as static content.
DOCUMENT_STORAGE_PATH=./.private-documents

# Frontend API origin (use 3002 when frontend and backend run together locally).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
NEXT_PUBLIC_DOCUMENT_VERIFICATION_DEMO_AUTH=true
