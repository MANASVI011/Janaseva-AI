{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-service": {
      "root": "ai-service",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 50
        }
      }
    },
    "backend": {
      "root": "backend",
      "framework": "nestjs",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build",
      "functions": {
        "src/main.ts": {
          "maxDuration": 60
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "ai-service",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
